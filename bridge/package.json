{
  "name": "pi-buddy-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pi-buddy bridge: plugin HTTP API, device WebSocket, and web simulator",
  "bin": {
    "pi-buddy-bridge": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "demo": "node --import tsx src/demo.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.ts"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
